{
  "name": "courtyard-house-planner",
  "version": "2.0.0",
  "description": "Courtyard house planner plus Studio, a parametric 2D and 3D design tool with 3D-print export.",
  "type": "module",
  "main": "electron/main.cjs",
  "private": true,
  "author": "Your name",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "build:www": "node scripts/build.mjs",
    "test": "node --test",
    "test:legacy": "node tests/legacy/run.cjs",
    "start": "npm run build:www && electron .",
    "dist:win": "npm run build:www && electron-builder --win --publish never",
    "android:sync": "npm run build:www && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/share": "^6.0.3",
    "earcut": "^3.0.0",
    "polygon-clipping": "^0.15.7",
    "replicad": "^1.1.0",
    "replicad-opencascadejs": "^1.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "three": "0.128.0"
  },
  "build": {
    "appId": "com.courtyard.planner",
    "productName": "Courtyard House Planner",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
